// Imported radio/data support from device_xiaomi_mido@mido-4.19.
// Keep this file limited to CNE/QMI/DPM/RIL dependencies.

cc_prebuilt_library_shared {
    name: "com.qualcomm.qti.dpm.api@1.0_vendor",
    owner: "motorola",
    stem: "com.qualcomm.qti.dpm.api@1.0",
    strip: { none: true },
    srcs: ["proprietary/vendor/lib64/com.qualcomm.qti.dpm.api@1.0.so"],
    shared_libs: [
        "libhidlbase", "liblog", "libutils", "libcutils",
        "libc++", "libc", "libm", "libdl",
    ],
    compile_multilib: "64",
    prefer: true,
    soc_specific: true,
}

